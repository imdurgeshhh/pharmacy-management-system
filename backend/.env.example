PORT=5000
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Database connection: Use DATABASE_URL or individual DB_* variables
# For Supabase on IPv4 cloud platforms (e.g. Render), use the connection pooler host:
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL=

DB_USER=
DB_HOST=
DB_NAME=postgres
DB_PASSWORD=
DB_PORT=5432

# Clerk keys from Clerk Dashboard > API Keys (both required in production)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

SHOP_NAME=
SHOP_ADDRESS=
SHOP_DL_NO=
SHOP_GSTIN=
SHOP_PHONE=
SHOP_PAN=
SHOP_AADHAR=
SHOP_FOOD_LIC=
SHOP_EMAIL=

# Rate Limiting (all configurable in ms and max requests)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
