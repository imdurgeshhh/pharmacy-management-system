{
  "info": {
    "_postman_id": "pharma-api-collection-v1",
    "name": "Pharma Backend API",
    "description": "Complete API test collection for the Pharma pharmacy management system.\nDerived from openapi.yaml and the actual route/controller code.\n\nPre-requisites:\n  1. Start the backend server (npm run dev)\n  2. Set BASE_URL in the environment (default: http://localhost:5000/api)\n  3. Run the clerk-sync request first — it auto-sets ADMIN_TOKEN env var\n\nBug documentation:\n  - BUG-01: Most endpoints have no auth guard\n  - BUG-03: DELETE /inventory/medicine/:id returns 200 for non-existent IDs\n  - BUG-06: Any authenticated user can update any employee\n  - BUG-08: No idempotency on POST /sales and POST /purchases",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000/api" },
    { "key": "ADMIN_TOKEN", "value": "" },
    { "key": "SUPPLIER_ID", "value": "" },
    { "key": "MEDICINE_ID", "value": "" },
    { "key": "INVENTORY_ID", "value": "" },
    { "key": "CUSTOMER_ID", "value": "" },
    { "key": "SALE_ID", "value": "" },
    { "key": "PURCHASE_ID", "value": "" },
    { "key": "EMPLOYEE_ID", "value": "" },
    { "key": "WS_SALE_ID", "value": "" },
    { "key": "WS_PURCHASE_ID", "value": "" }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status is OK', () => pm.expect(pm.response.json().status).to.eql('OK'));",
                  "pm.test('Response time < 2000ms', () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/health" }
          }
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "POST /auth/clerk-sync",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const json = pm.response.json();",
                  "pm.test('Has user object', () => pm.expect(json.user).to.be.an('object'));",
                  "pm.test('User has id', () => pm.expect(json.user.id).to.be.a('number'));",
                  "pm.test('User has role', () => pm.expect(['admin','shopkeeper','employee']).to.include(json.user.role));",
                  "pm.test('No token in response (MSW mock bug)', () => pm.expect(json.user.token).to.be.undefined);",
                  "pm.collectionVariables.set('ADMIN_TOKEN', 'clerk-session-token-placeholder');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/auth/clerk-sync" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"full_name\": \"Test Admin\",\n  \"username\": \"testadmin\"\n}"
            }
          }
        },
        {
          "name": "GET /auth/employees (admin only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401/403', () => pm.expect(pm.response.code).to.be.oneOf([200,401,403]));",
                  "if (pm.response.code === 200) {",
                  "  pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{BASE_URL}}/auth/employees" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ADMIN_TOKEN}}" }] }
          }
        },
        {
          "name": "POST /auth/clerk-sync — missing email → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "pm.test('Has error field', () => pm.expect(pm.response.json().error).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{BASE_URL}}/auth/clerk-sync" },
            "body": { "mode": "raw", "raw": "{ \"full_name\": \"No Email\" }" }
          }
        }
      ]
    },
